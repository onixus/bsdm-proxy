# Pilot ml-worker pack (Horizon 2 P2) — one model only
# Docs: docs/getting-started/pilot-ml.md · docs/analytics/ml-security.md
#
# Usage with compose:
#   set -a; source config/pilot-ml.env.example; set +a
#   docker compose -f docker-compose.yml -f deploy/compose/docker-compose.pilot.yml \
#     --profile ml up -d --build ml-worker

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=bsdm
CLICKHOUSE_TABLE=http_cache

# Recommended pilot model: UEBA z-score (falls back to anomaly_stub when baseline is thin)
ML_MODEL=ueba_zscore_v0
ML_ENTITY_TYPES=client_ip
ML_MIN_REQUESTS=5
ML_POLL_INTERVAL_SECS=60
ML_LOOKBACK_SECS=300
ML_SCORE_THRESHOLD=0.8

# Population baseline (live CH or optional offline artifact)
ML_BASELINE_LOOKBACK_SECS=86400
ML_BASELINE_MIN_SAMPLES=20
ML_ZSCORE_CLIP=4.0
# ML_BASELINE_PATH=/etc/bsdm-proxy/baseline.json

# M5.5 write-back for GET /api/threat-scores (proxy poll is separate / opt-in)
ML_WRITEBACK_ENABLED=true
ML_WRITEBACK_MIN_SCORE=0.5
ML_WRITEBACK_TTL_SECS=3600

# Optional SIEM — leave empty for silent pilot
# ML_WEBHOOK_URL=http://host.docker.internal:9080/hooks/ml

METRICS_PORT=8091

# Proxy side (only if you want enrich-only threat_sources; default OFF)
# THREAT_SCORE_ENABLED=true
# THREAT_SCORE_POLL_URL=http://ml-worker:8091/api/threat-scores
# THREAT_SCORE_POLL_INTERVAL_SECS=60
# THREAT_SCORE_WARN_THRESHOLD=0.7
# THREAT_SCORE_BLOCK_THRESHOLD=0
