# Pilot alert-worker pack (Horizon 2) — copy into compose env or .env
# Docs: docs/getting-started/pilot-alerts.md · docs/analytics/alerting.md

# Required destination (echo server for lab):
#   python3 scripts/alert-worker/webhook-echo.py 9080
ALERT_WEBHOOK_URL=http://host.docker.internal:9080/hooks/siem
# ALERT_WEBHOOK_HEADERS={"Authorization":"Bearer change-me"}

# Pilot-focused rule subset (deny flood + domain flood + off-hours threat)
ALERT_RULES=blocked_burst,domain_burst,off_hours_threat

# Slightly gentler thresholds for a 100-user pilot
ALERT_BLOCKED_BURST_THRESHOLD=10
ALERT_DOMAIN_BURST_THRESHOLD=80
ALERT_LOOKBACK_SECS=300
ALERT_POLL_INTERVAL_SECS=60
ALERT_DEDUPE_TTL_SECS=3600

CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=bsdm
CLICKHOUSE_TABLE=http_cache
METRICS_PORT=8090
