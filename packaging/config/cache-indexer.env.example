# BSDM-Proxy cache-indexer configuration
# Copy to /etc/bsdm-proxy/cache-indexer.env and adjust values.

KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=cache-events
KAFKA_GROUP_ID=cache-indexer-group

CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=bsdm
CLICKHOUSE_TABLE=http_cache
# CLICKHOUSE_USER=default
# CLICKHOUSE_PASSWORD=

METRICS_PORT=8080
# Admin / Search API listen host (default 0.0.0.0). Use 127.0.0.1 when only
# local clients (proxy on the same host) need /api/search and /metrics.
# METRICS_BIND=0.0.0.0
# Concurrent admin connections; extra connections are dropped (default 256).
# INDEXER_HTTP_MAX_CONNECTIONS=256
# Deadline to receive a full request / send the response, ms (default 10000).
# INDEXER_HTTP_READ_TIMEOUT_MS=10000
# SEARCH_API_ENABLED=true
# SEARCH_API_TOKEN=
# Separate token for POST /api/events (falls back to SEARCH_API_TOKEN; set it so
# Search API readers cannot write or overwrite events).
# INGEST_API_TOKEN=
# SEARCH_API_MAX_LIMIT=10000
# SEARCH_API_DEFAULT_DAYS=30

# Logging — see docs/ops-and-dev/logging.md
RUST_LOG=info,cache_indexer=info
RUST_BACKTRACE=0
