# BSDM-Proxy threat-intel collector configuration
# Copy to /etc/bsdm-proxy/threat-intel.env.
# Docs: docs/features/threat-intel-collector.md

# Enabled feeds, in collection order.
TI_SOURCES=openphish,phishstats,phishing_database,urlhaus

# Per-source endpoint overrides (defaults come from the feed vendors).
# TI_OPENPHISH_URL=https://openphish.com/feed.txt
# TI_PHISHSTATS_URL=https://phishstats.info/phish_score.csv
# TI_PHISHING_DATABASE_URL=https://raw.githubusercontent.com/mitchellkrogza/Phishing.Database/master/phishing-domains-ACTIVE.txt
# TI_URLHAUS_URL=https://urlhaus.abuse.ch/downloads/csv_recent/

# Scheduling and error handling. Minimum poll interval is 60s.
TI_POLL_INTERVAL_SECS=900
TI_HTTP_TIMEOUT_SECS=30
TI_MAX_ATTEMPTS=3
TI_RETRY_BACKOFF_SECS=5

# Safety caps on a single fetch.
TI_MAX_BODY_MB=64
TI_MAX_INDICATORS_PER_FETCH=500000

# Enforcement mode (issue #330): shadow (default) or enforce.
# In shadow mode RPZ/ACL artifacts are written as <path>.shadow and cannot be
# picked up by dns-sinkhole or the proxy. Only an explicit `enforce` blocks.
TI_ENFORCEMENT_MODE=shadow

# Snapshot output: <dir>/<source>.jsonl plus <dir>/report.json.
TI_OUTPUT_DIR=/var/lib/bsdm-proxy/threat-intel
# TI_USER_AGENT=bsdm-threat-intel/0.9.13

# Collect every source once and exit (cron-style runs, CI smoke).
# TI_RUN_ONCE=false

# Admin/SOAR API. Bind is loopback by default; SOAR endpoints (/api/v1/soar/*)
# require `Authorization: Bearer $TI_API_TOKEN` and are refused when no token is
# configured (DEPLOYMENT_PROFILE=production). Lab-only escape hatch:
# TI_API_ALLOW_INSECURE=true.
# TI_ADMIN_BIND=127.0.0.1
# TI_API_TOKEN=
# TI_SOAR_AUDIT_PATH=/var/lib/bsdm-proxy/threat-intel/soar-audit.jsonl
# TI_SOAR_AUDIT_MAX_BYTES=10485760
# TI_SOAR_DEFAULT_CONFIDENCE=90
# TI_SOAR_MAX_CONFIDENCE=100

# Enterprise SIEM export. Formats: cef, ecs, syslog.
# TI_SIEM_SYSLOG_ADDR=127.0.0.1:514
# TI_SIEM_SYSLOG_PROTOCOL=udp
# TI_SIEM_FILE_PATH=/var/lib/bsdm-proxy/threat-intel/siem_events.log
# TI_SIEM_FORMAT=cef

METRICS_PORT=8093
RUST_LOG=info,threat_intel=info
RUST_BACKTRACE=0

