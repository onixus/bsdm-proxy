# Optional DNS sinkhole sidecar (separate binary; not in proxy)
# See docs/features/dns-sinkhole.md · ADR 0004
DNS_SINKHOLE_ENABLED=true
DNS_SINKHOLE_BIND=0.0.0.0:53
DNS_SINKHOLE_UPSTREAM=1.1.1.1:53
DNS_SINKHOLE_ZONE_PATH=/etc/bsdm-proxy/blocklist.rpz
DNS_SINKHOLE_ACTION=sinkhole
DNS_SINKHOLE_A=127.0.0.1
DNS_SINKHOLE_AAAA=::1
DNS_SINKHOLE_TTL=300
DNS_SINKHOLE_UPSTREAM_TIMEOUT_MS=2000
METRICS_PORT=8092

# Encrypted listeners require DNS_SINKHOLE_TLS_CERT and DNS_SINKHOLE_TLS_KEY.
# Keep them disabled in the native package until certificates are configured.
DNS_SINKHOLE_DOH_ENABLED=false
DNS_SINKHOLE_DOT_ENABLED=false
