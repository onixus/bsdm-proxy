# BSDM Local Policy Agent (agent-spike) — pilot multi-OS install
# Copy to /etc/bsdm-agent/agent.env (Linux) or ~/.config/bsdm-agent/agent.env (macOS/user).

# Control plane (metrics/control HTTP or agent mTLS URL)
CONTROL_PLANE_URL=http://127.0.0.1:9090
# CONTROL_API_TOKEN=
# AGENT_ENROLL_TOKEN=

# Device identity
DEVICE_ID=dev-pilot-001
DEVICE_NAME=Pilot laptop
DEVICE_TYPE=desktop
# DEVICE_PLATFORM=linux|macos|windows  (auto-detected if unset)
# DEVICE_TOKEN=   # set after first enroll; or leave empty to enroll on start

# Data-plane proxy the OS should use (system proxy hooks)
SYSTEM_PROXY_HOST=127.0.0.1
SYSTEM_PROXY_PORT=3128
# SYSTEM_PROXY_BYPASS=localhost,127.0.0.1,::1,*.local
# SYSTEM_PROXY_LINUX_MODE=user   # user|gsettings|system|all

# Runtime
HEARTBEAT_INTERVAL_SECS=30
# AGENT_POLICY_PUSH=1
# AGENT_POLICY_WS=0
# AGENT_MTLS=0
# AGENT_MANAGE_SYSTEM_PROXY=0   # set/clear OS proxy around agent process
