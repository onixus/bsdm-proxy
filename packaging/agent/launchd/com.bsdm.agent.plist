<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bsdm.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bsdm-agent/bin/bsdm-agent</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>CONTROL_PLANE_URL</key>
		<string>http://127.0.0.1:9090</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/usr/local/var/log/bsdm-agent.log</string>
	<key>StandardErrorPath</key>
	<string>/usr/local/var/log/bsdm-agent.err</string>
</dict>
</plist>
