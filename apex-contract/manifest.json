        "POST /api/v1/agent/enroll",
        "GET /api/v1/agent/policy",
        "POST /api/v1/agent/heartbeat",
        "POST /api/v1/agent/events"
      ]
    }
  ],
  "native_contracts": [
    {
      "path": "bsdm-events/src/lib.rs",
      "kind": "wire-model"
    },
    {
      "path": "docs/architecture/agent-contract.md",
      "kind": "http-contract"
    }
  ],
  "resources": {
    "owns": [
      "event",
      "evidence",
      "policy"
    ],
    "references": [
      "asset"
    ]
  },
  "source_guards": [
