# Generated by BSDM Admin Console
# See packaging/config/bsdm-proxy.env.example for full reference

HTTP_PORT=3128
METRICS_PORT=9090
POLICY_MODE=selective-mitm
MITM_CATEGORIES=malware,phishing,illegal-content
MITM_ENABLED=true
# Bound in-memory MITM state (see docs/ops-and-dev/configuration.md)
MITM_CIRCUIT_BREAKER_MAX_DOMAINS=10000
MITM_CERT_CACHE_MAX_ENTRIES=10000
SHUTDOWN_TIMEOUT_SECONDS=30
RUST_LOG=info,bsdm_proxy=info
CACHE_CAPACITY=10000
CACHE_TTL_SECONDS=3600
MAX_CACHE_BODY_SIZE=10485760
CACHE_SHARDS=16
CACHE_HONOR_CACHE_CONTROL=true
NEGATIVE_CACHE_ENABLED=true
NEGATIVE_CACHE_TTL_SECONDS=120
CACHE_SPILL_THRESHOLD_BYTES=262144
REDIS_L2_ENABLED=true
REDIS_URL=redis://redis:6379
REDIS_KEY_PREFIX=bsdm:http:
WORKER_COUNT=1
PERF_FAST_CACHE_HIT=true
STREAMING_MISS_ENABLED=true
KAFKA_SAMPLE_RATE=0
METRICS_SAMPLE_RATE=0
KAFKA_QUEUE_CAPACITY=8192
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=cache-events
KAFKA_ACKS=1
AUTH_ENABLED=true
AUTH_BACKEND=basic
AUTH_REALM=BSDM-Proxy
AUTH_CACHE_TTL=300
ACL_ENABLED=true
ACL_DEFAULT_ACTION=allow
ACL_RULES_PATH=/etc/bsdm-proxy/acl-rules.json
ACL_AUTO_RELOAD=true
ACL_RELOAD_INTERVAL=60
CATEGORIZATION_ENABLED=true
CATEGORIZATION_CACHE_TTL=3600
UT1_ENABLED=true
UT1_PATH=/var/lib/ut1-blacklists
URLHAUS_ENABLED=true
URLHAUS_API=https://urlhaus-api.abuse.ch/v1/url/
PHISHTANK_ENABLED=false
PHISHTANK_API=https://checkurl.phishtank.com/checkurl/
CUSTOM_DB_ENABLED=true
CUSTOM_DB_PATH=/etc/bsdm-proxy/custom-categories.json
ICAP_ENABLED=false
ICAP_URL=icap://127.0.0.1:1344/echo
ICAP_FAIL_OPEN=true
ICAP_REQMOD=true
ICAP_RESPMOD=true
ALERT_WORKER_ENABLED=false
AI_CACHE_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
QDRANT_URL=http://127.0.0.1:6333
RKN_SYNC_ENABLED=true
RKN_SYNC_URL=https://svn.code.sf.net/p/zapret-info/code/dump.csv
RKN_FALLBACK_URL=https://raw.githubusercontent.com/1andrevich/Re-filter-lists/main/domains_all.lst
RKN_SYNC_INTERVAL_SECS=86400
RKN_SNAPSHOT_PATH=/var/lib/bsdm-proxy/rkn-registry.json
RKN_MIN_ENTRIES=1000
DOH_ENABLED=false
DOH_BIND=0.0.0.0:8443
DOT_ENABLED=false
DOT_BIND=0.0.0.0:853
KAFKA_BATCH_SIZE=100
KAFKA_BATCH_TIMEOUT=5000
CLICKHOUSE_URL=http://clickhouse:8123
CLICKHOUSE_DATABASE=bsdm
CLICKHOUSE_TABLE=http_cache
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
UPSTREAM_HTTP2_ENABLED=true
HTTP_PRESERVE_HEADER_CASE=true
THREAT_SCORE_ENABLED=true
THREAT_SCORE_POLL_URL=http://127.0.0.1:8091/api/threat-scores
THREAT_SCORE_POLL_INTERVAL_SECS=30
THREAT_SCORE_BLOCK_THRESHOLD=0.9
THREAT_SCORE_WARN_THRESHOLD=0.7
# Threat-intel Shadow Mode (issue #330): observe-only IOC matching. The proxy
# reads the collector's `.shadow` export, emits `threat_shadow_match` into the
# event pipeline and counts bsdm_proxy_ti_shadow_matches_total{feed}. It never
# blocks: enforcement requires TI_ENFORCEMENT_MODE=enforce on threat-intel.
TI_SHADOW_MATCH_ENABLED=true
TI_SHADOW_FEED_PATH=/var/lib/bsdm-proxy/threat-intel/threat_domains.json.shadow
TI_SHADOW_RELOAD_SECS=300
HTCP_SERVER_ENABLED=true
HTCP_BIND=0.0.0.0:4827
PEER_DISCOVERY_ENABLED=true
PEER_DISCOVERY_MULTICAST=239.255.77.77:3132
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_KEYS=100000
EBPF_XDP_ENABLED=true
EBPF_XDP_IFACE=eth0
EBPF_XDP_MODE=driver
