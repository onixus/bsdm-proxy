# Non-secret settings for deploy/compose/docker-compose.prod.yml.
#   cp deploy/compose/prod.env.example deploy/compose/prod.env
#   docker compose -f deploy/compose/docker-compose.prod.yml --env-file deploy/compose/prod.env up -d
# Secrets (tokens, basic-auth users) do NOT go here — they are files under
# deploy/compose/secrets/ (see the header of docker-compose.prod.yml).

# --- Release (mandatory) ---------------------------------------------------
# Image tag = released version without the leading "v".
BSDM_IMAGE_TAG=1.0.0
# Optional: pin by digest instead (recommended; verify the signature first:
#   cosign verify ghcr.io/onixus/bsdm-proxy@sha256:... \
#     --certificate-identity-regexp '^https://github.com/onixus/bsdm-proxy/\.github/workflows/docker-publish\.yml@refs/tags/v.*$' \
#     --certificate-oidc-issuer https://token.actions.githubusercontent.com)
# BSDM_PROXY_IMAGE=ghcr.io/onixus/bsdm-proxy@sha256:...
# BSDM_DNS_SINKHOLE_IMAGE=ghcr.io/onixus/bsdm-dns-sinkhole@sha256:...
# BSDM_CACHE_INDEXER_IMAGE=ghcr.io/onixus/bsdm-cache-indexer@sha256:...

# --- Exposure ---------------------------------------------------------------
# Client-facing IP for the proxy (mandatory). 0.0.0.0 = every interface.
PROXY_BIND=10.0.0.10
# PROXY_HOST_PORT=3128
# Internal resolver interface for the DNS sinkhole (default 127.0.0.1).
# DNS_BIND=10.0.0.10
# DNS_HOST_PORT=53
# Control plane is always published on 127.0.0.1 only.
# METRICS_HOST_PORT=9090

# --- Paths (relative to deploy/compose/) ------------------------------------
# BSDM_SECRETS_DIR=./secrets
# BSDM_CERTS_DIR=../../certs
# ACL_RULES_HOST=../../config/bsdm-etc/acl-rules.json
# PINNING_EXCEPTIONS_HOST=../../config/pinning-exceptions.example.json

# --- Policy -----------------------------------------------------------------
# MITM_CATEGORIES=malware,phishing,illegal-content
# ACL_DEFAULT_ACTION=allow
# CATEGORIZATION_ENABLED=false
# RKN_SYNC_ENABLED=false
# CONNECT allow-list; extend deliberately.
# ALLOWED_CONNECT_PORTS=443,8443
# 0 when clients come through a pooling downstream proxy / load balancer.
# AUTH_CONN_CACHE_TTL_SECONDS=300
# AUTH_REALM=BSDM-Proxy
# Buffered request body cap (bytes).
# MAX_REQUEST_BODY_BYTES=67108864

# --- Sizing -----------------------------------------------------------------
# PROXY_CPUS=4.0
# PROXY_MEMORY=4G
# WORKER_COUNT=2
# CACHE_CAPACITY=50000
# CACHE_TTL_SECONDS=3600
# MAX_CACHE_BODY_SIZE=4194304

# --- DNS sinkhole -----------------------------------------------------------
# DNS_SINKHOLE_UPSTREAM=1.1.1.1:53
# DNS_SINKHOLE_ACTION=sinkhole
# DNS_SINKHOLE_A=0.0.0.0

# --- Analytics profile (--profile analytics) ---------------------------------
# EVENT_SINK_URL=http://cache-indexer:8080/api/events
# SEARCH_UPSTREAM_URL=http://cache-indexer:8080
# SQLITE_MAX_ROWS=5000000
# SEARCH_API_DEFAULT_DAYS=30
