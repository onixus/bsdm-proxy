// eBPF/XDP lab run on a real Linux kernel (docs/features/ebpf-xdp.md).
//
// The macOS controller has no BPF, so the sources are stashed there and the
// run happens on a Linux agent. Everything kernel-facing stays inside one
// container started with --privileged --network none: the XDP program is
// attached to a veth pair in the container's own network namespace, never to
// the agent's NICs (the gaming node carries a VPN with a kill-switch).
//
// The agent needs only docker; toolchain and BPF tools come from
// ci/ebpf-lab/Dockerfile.

def IMAGE = 'bsdm-ebpf-lab:latest'
// Volumes are created by the unprivileged `lab` user of the image (see Dockerfile).
def CACHE_ARGS = '-v bsdm-ebpf-lab-cargo:/usr/local/cargo/registry -v bsdm-ebpf-lab-target:/target'

pipeline {
    agent none
    options {
        timeout(time: 60, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        // Every stage checks out explicitly: the agent cannot reach the
        // controller's /Users/... path, so it gets the sources via stash.
        skipDefaultCheckout()
    }
    stages {
        stage('Checkout') {
            agent { label 'built-in' }
            steps {
                checkout scm
                // The workspace is a VirtioFS bind mount that loses writes
                // (see Jenkinsfile.local). Stashing the working tree gave the
                // agent an unparseable tar, and a git archive written into the
                // workspace came out as corrupt gzip with a matching checksum.
                // So the archive is built from git objects into the
                // container's own /tmp, verified there, and stashed from there.
                dir("/tmp/bsdm-ebpf-lab-${env.BUILD_NUMBER}") {
                    sh '''
                        git -C "$WORKSPACE" archive --format=tar.gz -o "$PWD/src.tgz" HEAD -- . ':(exclude)admin-console'
                        gzip -t src.tgz
                        sha256sum src.tgz > src.tgz.sha256
                    '''
                    stash name: 'src', includes: 'src.tgz,src.tgz.sha256'
                    deleteDir()
                }
            }
        }
        stage('eBPF lab') {
            agent { label 'linux && docker' }
            stages {
                stage('Image') {
                    steps {
                        deleteDir()
                        // Cache volumes of the root-owned image generation;
                        // superseded by bsdm-ebpf-lab-* and only eat disk.
                        sh '''
                            docker volume rm bsdm-ebpf-cargo bsdm-ebpf-target 2>/dev/null || true
                            df -h / "$WORKSPACE" "$(docker info -f '{{.DockerRootDir}}')" || true
                            docker system df || true
                        '''
                        unstash 'src'
                        sh 'sha256sum -c src.tgz.sha256 && tar xzf src.tgz && rm src.tgz src.tgz.sha256'
                        sh "docker build -t ${IMAGE} ci/ebpf-lab"
                    }
                }
                stage('Build proxy') {
                    steps {
                        sh """
                            docker run --rm ${CACHE_ARGS} -e CARGO_TARGET_DIR=/target \
                              -v "\$PWD":/src -w /src ${IMAGE} \
                              cargo build -p bsdm-proxy --bin proxy --no-default-features --features auth-basic
                        """
                    }
                }
                stage('Kernel smoke') {
                    steps {
                        sh """
                            docker run --rm --user 0 --privileged --network none ${CACHE_ARGS} \
                              -v "\$PWD":/src -w /src ${IMAGE} bash ci/ebpf-lab/run.sh
                        """
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'ci-logs/**', allowEmptyArchive: true
                        }
                    }
                }
            }
            post {
                always {
                    // The containers run as root; hand the workspace back to the
                    // agent user so the next deleteDir() does not trip on it.
                    sh "docker run --rm --user 0 -v \"\$PWD\":/src ${IMAGE} chown -R \$(id -u):\$(id -g) /src || true"
                }
            }
        }
    }
}
